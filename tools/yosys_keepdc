#!/usr/bin/env python3
"""Yosys wrapper for the P0 netlist-fidelity fix.

The course scripts call `yosys -s synth.ys`; the generated script contains the
built-in `synth -top ... -noabc -flatten` command.  Yosys 0.63's `opt -full`
inside that command performs a don't-care optimization that deletes the D$ or
mis-slices its 10-bit set index.  This wrapper replaces the `synth` command with
the equivalent expanded pass sequence and adds `-keepdc` to `opt -full`.

It is a workflow workaround, not a change to scripts/.  Set it in config.mk:
    YOSYS ?= $(FRAMEWORK_DIR)/tools/yosys_keepdc
"""
import os
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path


def real_yosys():
    appdir = os.environ.get("CPU2026_APPDIR")
    if appdir:
        candidate = Path(appdir) / "bin" / "yosys"
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return os.environ.get("REAL_YOSYS", "yosys")


def synth_sequence(top, flatten, hieropt, noabc, nofsm, noshare, noalumacc, nordff):
    opt = "opt -hier" if hieropt else "opt"
    fast = "opt -fast -full -hier" if hieropt else "opt -fast -full"
    full = "opt -full -hier -keepdc" if hieropt else "opt -full -keepdc"
    tail = "opt -fast -hier" if hieropt else "opt -fast"
    cmds = ["hierarchy -check -top " + top]
    if flatten:
        cmds.append("flatten")
    cmds += ["opt_expr", "opt_clean", "check"]
    cmds.append("opt -nodffe -nosdff")
    if not nofsm:
        cmds.append("fsm")
    cmds.append(opt)
    cmds.append("wreduce")
    cmds.append("peepopt")
    cmds.append("opt_clean")
    if not noalumacc:
        cmds.append("alumacc")
    if not noshare:
        cmds.append("share")
    cmds.append(opt)
    cmds.append("memory -nomap")
    cmds.append("opt_clean")
    cmds.append(fast)
    cmds.append("memory_map")
    cmds.append(full)
    if not noabc:
        # The course flow always passes -noabc; keep this branch explicit.
        cmds.append("abc -fast")
    cmds.append("techmap")
    if not noabc:
        cmds.append(tail)
    cmds.append("hierarchy -check")
    cmds.append("stat")
    cmds.append("check")
    return cmds


def expand_synth(line):
    args = shlex.split(line)
    if not args or args[0] != "synth":
        return None
    opts = set(args[1:])
    top = None
    for i, a in enumerate(args):
        if a == "-top" and i + 1 < len(args):
            top = args[i + 1]
    if not top:
        return None
    return synth_sequence(
        top=top,
        flatten="-flatten" in opts,
        hieropt="-hieropt" in opts,
        noabc="-noabc" in opts,
        nofsm="-nofsm" in opts,
        noshare="-noshare" in opts,
        noalumacc="-noalumacc" in opts,
        nordff="-nordff" in opts,
    )


def main():
    args = sys.argv[1:]
    script = None
    for i, a in enumerate(args):
        if a == "-s" and i + 1 < len(args):
            script = args[i + 1]
    if not script or not Path(script).is_file():
        os.execvp(real_yosys(), [real_yosys(), *args])

    original = Path(script).read_text().splitlines()
    patched = []
    changed = False
    for line in original:
        expanded = expand_synth(line.strip())
        if expanded is None:
            patched.append(line)
        else:
            patched.extend(expanded)
            changed = True
    if not changed:
        os.execvp(real_yosys(), [real_yosys(), *args])

    tmp = tempfile.NamedTemporaryFile("w", suffix=".ys", delete=False)
    tmp.write("\n".join(patched) + "\n")
    tmp.close()
    newargs = list(args)
    for i, a in enumerate(newargs):
        if a == "-s":
            newargs[i + 1] = tmp.name
    try:
        return subprocess.call([real_yosys(), *newargs])
    finally:
        os.unlink(tmp.name)


if __name__ == "__main__":
    sys.exit(main())
